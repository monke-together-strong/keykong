{
  "name": "key-kong",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun build --compile --define KEY_KONG_TESTING=false --outfile dist/bin/key-kong src/main.ts",
    "build:test": "bun build --compile --define KEY_KONG_TESTING=true --outfile dist/bin/key-kong src/main.ts",
    "build:helper": "swift build --package-path native/macos -c release && mkdir -p dist/libexec && cp native/macos/.build/release/key-kong-prompt dist/libexec/key-kong-prompt",
    "package:macos": "./scripts/package-macos.sh",
    "check": "bunx tsc --noEmit",
    "test": "bun run build:test && bun test",
    "test:swift": "swift test --package-path native/macos"
  },
  "devDependencies": {
    "@types/bun": "^1.2.21",
    "typescript": "^5.9.2"
  }
}
