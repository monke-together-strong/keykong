{
  "name": "keykong",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "bun scripts/build.ts",
    "build:test": "bun scripts/build.ts --testing",
    "build:helper": "sh scripts/build-macos-helper.sh",
    "install:local": "sh scripts/install-local.sh",
    "package:macos": "sh scripts/package-macos.sh",
    "smoke:ui": "bun run package:macos && bun scripts/run-macos-ui-smoke.ts",
    "test:ui": "bun scripts/test-macos-ui.ts",
    "check": "bunx tsc --noEmit",
    "test": "bun test",
    "test:swift": "swift test --package-path native/macos"
  },
  "devDependencies": {
    "@types/bun": "^1.2.21",
    "typescript": "^5.9.2"
  }
}
